class Calculator {
  int no1 = 0;
  int no2 = 0;
  int result = 0;

  // Function to set first number
  void setNo1(int n1) {
    no1 = n1;
  }

  // Function to set second number
  void setNo2(int n2) {
    no2 = n2;
  }

  // Display function
  void display() {
    print("The result is $result");
  }

  // Addition function
  void addition() {
    result = no1 + no2;
    display();
  }
}

void main() {
  // Create object
  Calculator c1 = Calculator();

  // Set values
  c1.setNo1(10);
  c1.setNo2(26);

  // Perform addition
  c1.addition();
}

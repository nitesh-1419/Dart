import 'dart:io';

void main() {
  // Accepting input
  print("Enter Student Name:");
  String name = stdin.readLineSync()!;

  print("Enter Course:");
  String course = stdin.readLineSync()!;

  print("Enter Marks:");
  double marks = double.parse(stdin.readLineSync()!);

  // Displaying output
  print("\n--- Student Details ---");
  print("Name: $name");
  print("Course: $course");
  print("Marks: $marks");
}

class Calculator {
  int no1 = 0;
  int no2 = 0;
  int result = 0;

  void setNo1(int n1) {
    no1 = n1;
  }

  void setNo2(int n2) {
    no2 = n2;
  }

  void addition() {
    result = no1 + no2;
  }

  void display() {
    print("The result is $result");
  }
}

// Module (separate function to run program)
void runCalculator() {
  Calculator c1 = Calculator();

  c1.setNo1(10);
  c1.setNo2(20);

  c1.addition();
  c1.display();
}

void main() {
  // Calling module
  runCalculator();
}

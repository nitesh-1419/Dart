class Student {
  int rollno = 0;
  String name = "";

  // Setter for roll number
  void setRollNo(int rno) {
    rollno = rno;
  }

  // Setter for name
  void setName(String n) {
    name = n;
  }

  // Getter for roll number
  int getRollNo() {
    return rollno;
  }

  // Getter for name
  String getName() {
    return name;
  }
}

void main() {
  // Creating object
  Student s1 = Student();

  // Setting values
  s1.setRollNo(17001);
  s1.setName("A");

  // Getting values
  int rno = s1.getRollNo();
  String nm = s1.getName();

  // Display output
  print("Roll No: $rno");
  print("Name: $nm");
}

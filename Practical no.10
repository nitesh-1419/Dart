void main() {
  // Create list
  var list1 = ["abc", 10, 12.5];

  // Access element
  print(list1[1]);

  // Length of list
  print(list1.length);

  // Index of element
  print(list1.indexOf(12.5));

  // Print full list
  print(list1);

  // Update element
  list1[0] = "xyz";
  print(list1);

  // Check empty
  print(list1.isEmpty);

  // Reverse list
  print(list1.reversed);

  // Add element
  list1.add("pqr");
  print(list1);

  // Add another element
  list1.add(false);
  print(list1);

  // Create another list
  var list2 = [2, 5, 7];

  // Add all elements of list2 to list1
  list1.addAll(list2);
  print(list1);

  // Insert element at index
  list1.insert(0, "mno");
  print(list1);
}
